@model IEnumerable<StageStory.Models.Internship>

@using StageStory.Models.Enum

@{
    ViewData["Title"] = "Gestion des Stages";
}

<style>
    :root {
        --primary-color: #8e44ad;
        --secondary-color: #3498db;
        --accent-color: #2ecc71;
        --dark-color: #2c3e50;
        --light-color: #f8f9fa;
        --text-color: #333;
        --border-radius: 12px;
        --box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        --transition: all 0.3s ease;
    }

    .btn-primary-custom {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
        transition: var(--transition);
    }

        .btn-primary-custom:hover {
            background-color: #7d3c98;
            border-color: #7d3c98;
            transform: translateY(-2px);
            box-shadow: var(--box-shadow);
        }

    .btn-outline-primary-custom {
        color: var(--primary-color);
        border-color: var(--primary-color);
    }

        .btn-outline-primary-custom:hover {
            background-color: var(--primary-color);
            color: white;
        }

    .card-header-custom {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: white;
        border-radius: var(--border-radius) var(--border-radius) 0 0 !important;
    }

    .status-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.85em;
        font-weight: 500;
    }

    .table-custom {
        border-radius: var(--border-radius);
        overflow: hidden;
        box-shadow: var(--box-shadow);
    }

        .table-custom thead th {
            background-color: var(--dark-color);
            color: white;
            border: none;
            font-weight: 600;
            padding: 15px;
        }

        .table-custom tbody tr {
            transition: var(--transition);
        }

            .table-custom tbody tr:hover {
                background-color: rgba(142, 68, 173, 0.05);
                transform: translateY(-2px);
            }

    .rating-stars {
        color: #FFD700;
    }

    .action-buttons .btn {
        margin-right: 5px;
        border-radius: 6px;
    }

    .salary-badge {
        background-color: rgba(46, 204, 113, 0.1);
        color: var(--accent-color);
        padding: 4px 10px;
        border-radius: 20px;
        font-weight: 500;
    }

    .date-cell {
        white-space: nowrap;
        font-size: 0.9em;
    }

    .page-title {
        color: var(--dark-color);
        font-weight: 700;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 3px solid var(--primary-color);
    }
</style>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="page-title">📋 Gestion des Stages</h1>
        </div>
    </div>

    <div class="card border-0 shadow-lg mb-5">
        <div class="card-header card-header-custom py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Liste des Stages</h5>
                <a asp-action="Create" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle me-2"></i>Nouveau Stage
                </a>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Entreprise</th>
                            <th>Étudiant</th>
                            <th>Statut</th>
                            <th>Note</th>
                            <th>Salaire</th>
                            <th>Période</th>
                            <th>Signature</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                    <small class="d-block text-muted">@Html.DisplayFor(modelItem => item.Description)</small>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Enterprise.Name)
                                </td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info">
                                        @(item.Student != null ? item.Student.Name : "Anonyme")
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var statusClass = item.Status switch
                                        {
                                            StatusEnum.Approved => "bg-success bg-opacity-10 text-success",
                                            // StatusEnum.Approved => "bg-secondary bg-opacity-10 text-secondary",
                                            StatusEnum.Pending => "bg-warning bg-opacity-10 text-warning",
                                            StatusEnum.Rejected => "bg-danger bg-opacity-10 text-danger",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="status-badge @statusClass">@Html.DisplayFor(modelItem => item.Status)</span>
                                </td>
                                <td>
                                    @if (item.Rating > 0)
                                    {
                                        <div class="rating-stars">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= item.Rating ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                        <small class="text-muted">@Html.DisplayFor(modelItem => item.Evaluation)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Non évalué</span>
                                    }
                                </td>
                                <td>
                                    @if (item.SalaryAmount > 0)
                                    {
                                        <span class="salary-badge">@Html.DisplayFor(modelItem => item.SalaryAmount) FCFA</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Non rémunéré</span>
                                    }
                                </td>
                                <td class="date-cell">
                                    <div>@item.StartDate.ToString("dd/MM/yy")</div>
                                    <div class="text-muted">au</div>
                                    <div>@item.EndDate.ToString("dd/MM/yy")</div>
                                </td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary">
                                        @Html.DisplayFor(modelItem => item.SignatureType)
                                    </span>
                                </td>
                                <td class="action-buttons">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Statistiques -->
    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid var(--primary-color);">
                <div class="card-body">
                    <h6 class="text-muted">Total Stages</h6>
                    <h3 class="mb-0">@Model.Count()</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid var(--accent-color);">
                <div class="card-body">
                    <h6 class="text-muted">Stages Actifs</h6>
                    <h3 class="mb-0">@Model.Count(s => s.Status == StatusEnum.Pending)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid var(--secondary-color);">
                <div class="card-body">
                    <h6 class="text-muted">Stages Terminés</h6>
                    <h3 class="mb-0">@Model.Count(s => s.Status == StatusEnum.Approved)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #FFD700;">
                <div class="card-body">
                    <h6 class="text-muted">Note Moyenne</h6>
                    <h3 class="mb-0">
                        @{
                            var ratedStages = Model.Where(s => s.Rating > 0);
                            var averageRating = ratedStages.Any() ? ratedStages.Average(s => s.Rating) : 0;
                        }
                        @String.Format("{0:0.0}", averageRating)/5
                    </h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<script>
    // Animation au survol des lignes
    document.addEventListener('DOMContentLoaded', function() {
        const rows = document.querySelectorAll('tbody tr');
        rows.forEach(row => {
            row.addEventListener('mouseenter', function() {
                this.style.boxShadow = '0 5px 15px rgba(142, 68, 173, 0.1)';
            });
            row.addEventListener('mouseleave', function() {
                this.style.boxShadow = 'none';
            });
        });
    });
</script>