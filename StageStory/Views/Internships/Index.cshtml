@model IEnumerable<StageStory.Models.Internship>

@using StageStory.Models.Enum

@{
    ViewData["Title"] = "Gestion des Stages";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">
    <link rel="stylesheet" href="~/css/stage.css"/>
   
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="page-title">📋 Gestion des Stages</h1>
        </div>
    </div>

    <!-- Statistiques -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid var(--primary-color);">
                <div class="card-body">
                    <h6 class="text-muted">Total Stages</h6>
                    <h3 class="mb-0" id="total-stages">@Model.Count()</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid var(--accent-color);">
                <div class="card-body">
                    <h6 class="text-muted">Stages en Attente</h6>
                    <h3 class="mb-0" id="pending-stages">@Model.Count(s => s.Status == StatusEnum.Pending)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid var(--secondary-color);">
                <div class="card-body">
                    <h6 class="text-muted">Stages Approuvés</h6>
                    <h3 class="mb-0" id="approved-stages">@Model.Count(s => s.Status == StatusEnum.Approved)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #FFD700;">
                <div class="card-body">
                    <h6 class="text-muted">Note Moyenne</h6>
                    <h3 class="mb-0" id="average-rating">
                        @{
                            var ratedStages = Model.Where(s => s.Rating > 0);
                            var averageRating = ratedStages.Any() ? ratedStages.Average(s => s.Rating) : 0;
                        }
                        @String.Format("{0:0.0}", averageRating)/5
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-lg">
        <div class="card-header card-header-custom py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Liste des Stages</h5>
                <div>
                    <a asp-action="Create" class="btn btn-light btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>Nouveau Stage
                    </a>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="internships-table" class="table table-hover table-custom" style="width:100%">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Entreprise</th>
                            <th>Étudiant</th>
                            <th>Statut</th>
                            <th>Note</th>
                            <th>Salaire</th>
                            <th>Période</th>
                            <th>Signature</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                    <small class="d-block text-muted">@(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</small>
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.Enterprise.Name)</td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info">
                                        @(item.Student != null ? item.Student.Name : "Anonyme")
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var statusClass = item.Status switch
                                        {
                                            StatusEnum.Approved => "bg-success bg-opacity-10 text-success",
                                            StatusEnum.Pending => "bg-warning bg-opacity-10 text-warning",
                                            StatusEnum.Rejected => "bg-danger bg-opacity-10 text-danger",
                                            _ => "bg-light text-dark"
                                        };
                                        var statusText = item.Status switch
                                        {
                                            StatusEnum.Approved => "Approuvé",
                                            StatusEnum.Pending => "En attente",
                                            StatusEnum.Rejected => "Rejeté",
                                            _ => item.Status.ToString()
                                        };
                                    }
                                    <span class="status-badge @statusClass">@statusText</span>
                                </td>
                                <td data-order="@item.Rating">
                                    @if (item.Rating > 0)
                                    {
                                        <div class="rating-stars">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= item.Rating ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                        <small class="text-muted">@(item.Evaluation?.Length > 20 ? item.Evaluation.Substring(0, 20) + "..." : item.Evaluation)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Non évalué</span>
                                    }
                                </td>
                                <td data-order="@item.SalaryAmount">
                                    @if (item.SalaryAmount > 0)
                                    {
                                        <span class="salary-badge">@Html.DisplayFor(modelItem => item.SalaryAmount) FCFA</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Non rémunéré</span>
                                    }
                                </td>
                                <td data-order="@item.StartDate.ToString("yyyyMMdd")">
                                    <div>@item.StartDate.ToString("dd/MM/yy")</div>
                                    <div class="text-muted">au</div>
                                    <div>@item.EndDate.ToString("dd/MM/yy")</div>
                                </td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary">
                                        @Html.DisplayFor(modelItem => item.SignatureType)
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm" title="Détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script>
        $(document).ready(function () {
            // Initialisation de DataTables
            var table = $('#internships-table').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json',
                    search: "_INPUT_",
                    searchPlaceholder: "Rechercher un stage..."
                },
                responsive: true,
                pageLength: 10,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Tous"]],
                order: [[0, 'asc']],
                // Configuration du DOM pour placer les éléments correctement
                dom: '<"row"<"col-md-6"B><"col-md-6"f>>' +
                     '<"row"<"col-md-12"tr>>' +
                     '<"row"<"col-md-6"l><"col-md-6"p>>',
                buttons: [
                    {
                        extend: 'copy',
                        text: '<i class="bi bi-clipboard me-1"></i>Copier',
                        className: 'btn btn-sm'
                    },
                    {
                        extend: 'csv',
                        text: '<i class="bi bi-file-earmark-spreadsheet me-1"></i>CSV',
                        className: 'btn btn-sm',
                        title: 'Liste_Stages_' + new Date().toISOString().split('T')[0]
                    },
                    {
                        extend: 'excel',
                        text: '<i class="bi bi-file-excel me-1"></i>Excel',
                        className: 'btn btn-sm',
                        title: 'Liste_Stages_' + new Date().toISOString().split('T')[0]
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="bi bi-file-pdf me-1"></i>PDF',
                        className: 'btn btn-sm',
                        title: 'Liste_Stages_' + new Date().toISOString().split('T')[0],
                        orientation: 'landscape'
                    },
                    {
                        extend: 'print',
                        text: '<i class="bi bi-printer me-1"></i>Imprimer',
                        className: 'btn btn-sm',
                        title: 'Liste des Stages'
                    }
                ],
                columnDefs: [
                    {
                        targets: [8], // Colonne Actions
                        orderable: false,
                        searchable: false,
                        className: 'text-center'
                    },
                    {
                        targets: [3], // Colonne Statut
                        render: function (data, type, row) {
                            return '<span class="status-badge ' + getStatusClass(row[3]) + '">' + data + '</span>';
                        }
                    },
                    {
                        targets: [4], // Colonne Note
                        render: function (data, type, row) {
                            return data;
                        }
                    },
                    {
                        targets: [5], // Colonne Salaire
                        render: function (data, type, row) {
                            return data;
                        }
                    },
                    {
                        targets: '_all',
                        className: 'align-middle'
                    }
                ],
                initComplete: function () {
                    // Personnalisation supplémentaire après initialisation
                    $('.dataTables_filter input').addClass('form-control form-control-sm');
                    $('.dataTables_length select').addClass('form-select form-select-sm');

                    // Mise à jour des statistiques
                    updateStatistics();
                },
                drawCallback: function (settings) {
                    // Mise à jour des statistiques à chaque redessin
                    updateStatistics();

                    // Animation au survol des lignes
                    $('#internships-table tbody tr').hover(
                        function () {
                            $(this).css('box-shadow', '0 5px 15px rgba(142, 68, 173, 0.1)');
                        },
                        function () {
                            $(this).css('box-shadow', 'none');
                        }
                    );
                }
            });

            // Fonction pour obtenir la classe CSS en fonction du statut
            function getStatusClass(status) {
                switch (status) {
                    case 'Approuvé': return 'bg-success bg-opacity-10 text-success';
                    case 'En attente': return 'bg-warning bg-opacity-10 text-warning';
                    case 'Rejeté': return 'bg-danger bg-opacity-10 text-danger';
                    default: return 'bg-light text-dark';
                }
            }

            // Fonction pour mettre à jour les statistiques
            function updateStatistics() {
                var data = table.rows({ search: 'applied' }).data();
                var total = data.count();
                var pending = 0;
                var approved = 0;
                var totalRating = 0;
                var ratedCount = 0;

                // Parcourir les données filtrées
                data.each(function (value, index) {
                    var status = value[3];
                    var ratingCell = value[4];

                    // Compter les statuts
                    if (status === 'En attente') pending++;
                    if (status === 'Approuvé') approved++;

                    // Extraire la note si elle existe
                    var ratingMatch = ratingCell.match(/data-order="([^"]+)"/);
                    if (ratingMatch && ratingMatch[1] && parseFloat(ratingMatch[1]) > 0) {
                        totalRating += parseFloat(ratingMatch[1]);
                        ratedCount++;
                    }
                });

                // Mettre à jour les statistiques
                $('#total-stages').text(total);
                $('#pending-stages').text(pending);
                $('#approved-stages').text(approved);

                var average = ratedCount > 0 ? (totalRating / ratedCount).toFixed(1) : '0.0';
                $('#average-rating').text(average + '/5');
            }

            // Écouteur pour les filtres de recherche
            table.on('search.dt', function () {
                updateStatistics();
            });

            // Écouteur pour le changement de page
            table.on('page.dt', function () {
                updateStatistics();
            });
        });
    </script>
}